{
    "name": "solid-box",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*",
        "apps/*",
        "tools/*"
    ],
    "scripts": {
        "ready": "vp check && vp run -r test && vp run -r build",
        "dev": "vp run target#dev",
        "prepare": "vp config",
        "test": "vp test"
    },
    "devDependencies": {
        "@changesets/cli": "^3.0.0",
        "vite": "catalog:",
        "vite-plus": "catalog:"
    },
    "overrides": {
        "vite": "catalog:"
    },
    "devEngines": {
        "packageManager": {
            "name": "bun",
            "version": "1.4.0",
            "onFail": "download"
        }
    },
    "catalog": {
        "vite": "npm:@voidzero-dev/vite-plus-core@0.3.2",
        "vite-plus": "0.3.2",
        "@types/node": "^24",
        "typescript": "^7.0.2",
        "tailwindcss": "^4.3.3",
        "@tailwindcss/vite": "^4.3.3",
        "solid-js": "2.0.0-rc.0",
        "@solidjs/vite-plugin": "3.0.0-next.28",
        "@solidjs/web": "2.0.0-rc.0",
        "clsx": "^2.1.1"
    }
}
